<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="view-transition" content="same-origin" />
    <title @text="title"></title>
    <link webc:keep rel="stylesheet" href="/styles/theme.css" />
    <link webc:keep rel="stylesheet" :href="$data.iconSet.url" />
	</head>
	<body class="min-h-screen bg-cover bg-center bg-[url('/static/abstract-background.jpg')] p-4 md:p-6">
    <main @raw="content" class="space-y-8"></main>
    <footer>
      <p class="text-center text-sm">
        &copy; <template @text="currentYear" webc:nokeep></template>
      </p>
    </footer>
  </body>
</html>